# ============================ SERVIDOR DEL JUEGO ============================
PORT=8080

# ---------------------------------------------------------------------------
# Supabase. Si dejas SUPABASE_URL vacío, el juego arranca en MODO DESARROLLO
# (login simulado y progreso guardado en .data/players.json).
# Supabase > Project Settings > API
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SECRETA: solo en el servidor. Nunca en Vercel ni en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Webs autorizadas a conectarse por WebSocket (separadas por comas).
# Local: vacío. Producción: la URL de tu web en Vercel.
# ALLOWED_ORIGINS=https://infinitylife.vercel.app

# NODE_ENV=production
# AUTOSAVE_MS=15000

# ====================== BUILD DEL CLIENTE (Vercel) =========================
# Estas las configuras en Vercel > Settings > Environment Variables
# (son públicas; el service_role NO va aquí):
#   SUPABASE_URL, SUPABASE_ANON_KEY
#   GAME_SERVER_URL=https://tu-servidor.onrender.com
